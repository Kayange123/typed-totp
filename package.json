{
  "name": "typed-totp",
  "version": "0.1.0",
  "description": "A TypeScript-first, zero-dependency TOTP/HOTP library (RFC 6238 / RFC 4226) built around clean, composable, dependency-injected abstractions.",
  "type": "module",
  "author": {
    "name": "Ayubu Kayange",
    "email": "kayangejr3@gmail.com"
  },
  "sideEffects": false,
  "license": "MIT",
  "keywords": [
    "totp",
    "hotp",
    "2fa",
    "mfa",
    "otp",
    "authentication",
    "rfc6238",
    "rfc4226",
    "typescript",
    "webcrypto"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "llms.txt",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build",
    "prepare": "husky",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "husky": "^9.1.7",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
